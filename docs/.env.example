# Optional custom model endpoints. Leave blank to use official Provider defaults.
VITE_QWEN_API_URL=
VITE_DEEPSEEK_API_URL=

# Optional custom MCP endpoint. Leave blank to use the official endpoint.
VITE_AMAP_MCP_URL=

# Optional development credentials. VITE_* values are embedded in the client bundle.
VITE_ALIYUN_DASHSCOPE_KEY=
VITE_DEEPSEEK_API_KEY=

# Optional single proxy endpoint. When set, it is used for both providers.
VITE_DOCS_ASSISTANT_API_URL=
