{
  "name": "@opentiny/tiny-robot-assistant",
  "version": "0.5.1",
  "license": "MIT",
  "description": "Embeddable TinyRobot AI assistant for Vue applications",
  "homepage": "https://docs.opentiny.design/tiny-robot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentiny/tiny-robot.git"
  },
  "bugs": {
    "url": "https://github.com/opentiny/tiny-robot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./vitepress": {
      "types": "./dist/vitepress.d.ts",
      "import": "./dist/vitepress.js",
      "default": "./dist/vitepress.js"
    },
    "./vitepress-plugin": {
      "types": "./dist/vitepress-plugin.d.ts",
      "import": "./dist/vitepress-plugin.js",
      "default": "./dist/vitepress-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README*"
  ],
  "scripts": {
    "build": "pnpm type-check && vite build",
    "dev": "vite --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentiny/tiny-robot": "workspace:*",
    "@opentiny/tiny-robot-chat": "workspace:*",
    "@opentiny/tiny-robot-kit": "workspace:*",
    "@opentiny/tiny-robot-svgs": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.3.11",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vitepress": "^1.6.3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitepress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.6.1",
    "vitepress": "^1.6.3",
    "vue": "^3.3.11",
    "vue-tsc": "^2.2.8"
  }
}
